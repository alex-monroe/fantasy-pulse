/app.json
/tsconfig.json
/ios/

# Claude Code — user-local; team-shared skills live in .claude/commands/
.claude/settings.local.json
.claude/worktrees/
# mcp (contains secrets)
.mcp.json

# Supabase CLI local cache (project ref, service versions, etc.)
supabase/.temp/
