# Copy to .env.local and populate with your credentials

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Yahoo OAuth configuration
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=

# Demo mode: set to 1 to serve deterministic, self-updating fake data on
# the whole instance (no providers required) so the live scoreboard can be
# exercised out of season. Leave blank/0 for normal operation. Browser
# sessions can also opt in per-session with ?demo=1 (clear with ?demo=0).
# See docs/DEMO_MODE.md.
DEMO_MODE=

# News digest (docs/NEWS_DIGEST.md)
# Bearer token /api/news/ingest requires. Vercel Cron sends it once the
# project defines it. Leave blank and the endpoint is disabled (503), not
# open — the digest page still refreshes the pool itself when it is stale.
CRON_SECRET=
# Optional override for the news feed URL. Defaults to Rotowire's public
# NFL news RSS.
ROTOWIRE_RSS_URL=
